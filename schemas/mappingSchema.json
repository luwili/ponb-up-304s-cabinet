{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "file": {
        "type": "string",
        "minLength": 1
      },
      "subjectId": {
        "type": "string",
        "pattern": "^[\\p{L}\\p{N}_-]+$"
      },
      "topicId": {
        "type": "string",
        "pattern": "^[\\p{L}\\p{N}_-]+$"
      },
      "topicTitle": {
        "type": "string",
        "minLength": 1
      },
      "material": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "default": "Учебный материал",
            "type": "string",
            "enum": [
              "Конспект",
              "Задача",
              "Презентация",
              "Учебный материал",
              "Вопросы к экзамену",
              "Судебная практика",
              "Другое"
            ]
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "variant": {
            "type": "string",
            "enum": [
              "full",
              "short"
            ]
          },
          "addedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "order": {
            "default": 0,
            "type": "number"
          },
          "relatedIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\p{L}\\p{N}_-]+$"
            }
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "verificationNote": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "task": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "questions": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "solution": {
                "type": "string"
              },
              "shortSolution": {
                "type": "string"
              },
              "sources": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "condition",
              "questions",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "tags",
          "order",
          "relatedIds"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "file",
      "subjectId",
      "topicId",
      "material"
    ],
    "additionalProperties": false
  }
}
