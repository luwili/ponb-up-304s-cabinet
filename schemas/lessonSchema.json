{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}_-]+$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}_-]+$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "parity": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "odd",
        "even"
      ]
    },
    "start": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "end": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "kind": {
      "type": "string"
    },
    "room": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "teacherId": {
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}_-]+$"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "subjectId",
    "parity",
    "start",
    "end"
  ],
  "additionalProperties": false
}
