{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "solution": {
      "type": "string"
    },
    "shortSolution": {
      "type": "string"
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "condition",
    "questions",
    "sources"
  ],
  "additionalProperties": false
}
