{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "teacherIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\p{L}\\p{N}_-]+$"
      }
    },
    "order": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "title",
    "teacherIds",
    "order"
  ],
  "additionalProperties": false
}
